{
  "name": "@amar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@amar/shared": "*",
    "@tanstack/react-query": "^5.64.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "comments": {
    "leaflet": "Driven directly rather than through react-leaflet: the map holds imperative state (viewport, cluster layer, marker reuse) that a declarative wrapper only re-wraps, and one fewer peer-version constraint on React."
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
