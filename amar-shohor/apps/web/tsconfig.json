{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "baseUrl": "../..",
    "paths": {
      "@amar/shared": ["packages/shared/src/index.ts"],
      "@amar/shared/*": ["packages/shared/src/*"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/shared/src"]
}
