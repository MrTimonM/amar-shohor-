{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "baseUrl": "../..",
    "paths": {
      "@amar/shared": ["packages/shared/src/index.ts"],
      "@amar/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/shared/src/**/*.ts"]
}
