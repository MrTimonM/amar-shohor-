# Five people, five machines. Without this, Windows checkouts rewrite every
# file to CRLF and the next commit shows the whole file as changed — which
# buries real work in noise and makes review pointless.
#
# Normalise to LF in the repository; let each machine check out what it wants.
* text=auto eol=lf

# Binary: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.pptx  binary
*.pdf   binary

# Generated — collapse it in pull request diffs.
package-lock.json linguist-generated=true -diff
